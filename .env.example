# Copiá a .env.local y completá los valores.
# https://nextjs.org/docs/app/guides/environment-variables

# --- Sanity CMS (contenido del sitio marketing) ---
# Crear proyecto en https://www.sanity.io/manage y ejecutar: npm run migrate:content

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Obligatorio en Vercel (Production + Preview) si usás Presentation / modo borrador.
# Sin esto, el sitio público sigue funcionando; el preview en Studio puede fallar.
SANITY_API_READ_TOKEN=
# Lectura (exportar Sanity → content/ con npm run sync:content). Viewer en sanity.io/manage.
SANITY_API_READ_TOKEN=
# Solo migración local → Sanity (npm run migrate:content). Editor con escritura.
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Página estilo Linktree (/links o subdominio con LINKS_HOSTNAME) ---

NEXT_PUBLIC_LINKS_BRAND_NAME=Luma Piel

# Opcional. Texto bajo el logo en /links (omití la variable para no mostrar frase).
# NEXT_PUBLIC_LINKS_TAGLINE=El abordaje que tu piel necesita

# Opcional. Dirección en el pie (default: Arenales 3819 2° "A", Palermo, CABA.)
# NEXT_PUBLIC_LINKS_FOOTER_ADDRESS=

# Ruta en /public o URL absoluta (https://...)
NEXT_PUBLIC_LINKS_LOGO_URL=/logo-piel.svg

# Número con código de país, con o sin + / espacios (se normaliza a wa.me)
NEXT_PUBLIC_LINKS_WHATSAPP_NUMBER=
# Mensaje opcional precargado al abrir WhatsApp
# NEXT_PUBLIC_LINKS_WHATSAPP_MESSAGE=Hola, quiero sacar turno

NEXT_PUBLIC_LINKS_WEB_BOOKING_URL=
NEXT_PUBLIC_LINKS_MAPS_URL=
NEXT_PUBLIC_LINKS_INSTAGRAM_URL=

# URL canónica para compartir (recomendado en producción). Si no se define, se usa el host de la petición.
# NEXT_PUBLIC_LINKS_SHARE_URL=https://links.tudominio.com

# Texto bajo el nombre en el modal de compartir (estilo */tu-handle). Si no va, se muestra host + ruta.
# NEXT_PUBLIC_LINKS_SHARE_PREVIEW_HANDLE=lumapiel

# Enlace opcional del botón superior izquierdo (ej. sitio principal)
# NEXT_PUBLIC_LINKS_MORE_URL=https://tudominio.com

# Textos de botones (opcionales)
# NEXT_PUBLIC_LINKS_LABEL_WHATSAPP=Turnos Whatsapp
# NEXT_PUBLIC_LINKS_LABEL_WEB=Turnos Web
# NEXT_PUBLIC_LINKS_LABEL_MAPS=Ubicación

# Host exacto del subdominio dedicado (sin https ni puerto). El middleware reescribe / → /links.
# Ejemplo: links.tudominio.com
# LINKS_HOSTNAME=
